# Writers Assistant - Backend Environment Configuration

# Server Port (assigned automatically by cloud platforms like Render / Railway / Heroku / AWS)
PORT=4000

# Google Gemini API Key (optional - system includes local offline heuristic engines if quota or key is not provided)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional - fallback LLM)
OPENAI_API_KEY=your_openai_api_key_here

# LanguageTool API Key (optional for premium spell/grammar checks)
LANGUAGE_TOOL_API_KEY=optional_languagetool_key

# Supabase Database & Auth (optional - backend uses local JSON file DB fallback if not configured)
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
